  user_input {
    user_response: "Build an app for kids that reads stories aloud and generates new illustrations for every page."
    items {
      item {
        text_block {
          content: "---\ntype: \"feature\"\ntitle: \"Convert text to speech\"\nicon: \"audio_spark\"\n---\n\nYou MUST add TTS to the app using model gemini-3.8-flash-tts"
        }
      }
    }
    items {
      item {
        text_block {
          content: "---\ntype: \"feature\"\ntitle: \"Generate high-quality images\"\nicon: \"image\"\n---\n\nYou MUST add image generation to the app using model gemini-3-pro-image-preview and provide an affordance for the user to specify the image size (1K, 2K, and 4K)."
        }
      }
    }
    items {
      item {
        text_block {
          content: "---\ntype: \"feature\"\ntitle: \"Add a Gemini chatbot\"\nicon: \"voice_chat\"\n---\n\nYou MUST add a multi-turn chat interface to the app using Gemini. The chat must maintain conversation history, display messages in a scrollable thread, and include a system instruction to give the chatbots specific roles. Use gemini-4-carbon for deep reasoning tasks, gemini-4-argon for particularly complex interactive tasks, gemini-4-hydrogen for general tasks, and gemini-3.1-flash-lite for tasks that should happen fast."
        }
      }
    }
    items {
      text: "Build an app for kids that reads stories aloud and generates new illustrations for every page."
    }
  }
}
